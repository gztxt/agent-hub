<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agent Hub - 智管</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0f172a; color: #e2e8f0; min-height: 100vh; }
        .header { background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); padding: 20px 40px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; }
        .header h1 { font-size: 24px; font-weight: 600; background: linear-gradient(90deg, #60a5fa, #a78bfa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .header .status { display: flex; align-items: center; gap: 8px; font-size: 14px; color: #94a3b8; }
        .header .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; animation: pulse 2s infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
        .container { max-width: 1400px; margin: 0 auto; padding: 40px; }
        .dashboard-title { font-size: 18px; font-weight: 500; margin-bottom: 24px; color: #94a3b8; }
        .agents-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }
        .agent-card { background: #1e293b; border: 1px solid #334155; border-radius: 12px; padding: 24px; transition: all 0.2s; cursor: pointer; }
        .agent-card:hover { border-color: #60a5fa; transform: translateY(-2px); box-shadow: 0 8px 32px rgba(96, 165, 250, 0.1); }
        .agent-card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
        .agent-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; }
        .agent-icon.claude { background: linear-gradient(135deg, #7c3aed, #a78bfa); }
        .agent-icon.pi { background: linear-gradient(135deg, #2563eb, #60a5fa); }
        .agent-icon.jcode { background: linear-gradient(135deg, #059669, #34d399); }
        .agent-icon.tdaI { background: linear-gradient(135deg, #dc2626, #f87171); }
        .agent-status { display: flex; align-items: center; gap: 6px; font-size: 12px; padding: 4px 10px; border-radius: 20px; }
        .agent-status.running { background: #052e16; color: #4ade80; }
        .agent-status.stopped { background: #450a0a; color: #f87171; }
        .agent-status.unknown { background: #1c1917; color: #a8a29e; }
        .agent-name { font-size: 18px; font-weight: 600; margin-bottom: 4px; }
        .agent-type { font-size: 12px; color: #64748b; margin-bottom: 12px; }
        .agent-desc { font-size: 14px; color: #94a3b8; line-height: 1.5; }
        .agent-meta { display: flex; gap: 16px; margin-top: 16px; padding-top: 16px; border-top: 1px solid #334155; font-size: 12px; color: #64748b; }
        .agent-meta span { display: flex; align-items: center; gap: 4px; }
        .footer { text-align: center; padding: 40px; color: #475569; font-size: 12px; }
        .loading { text-align: center; padding: 60px; color: #64748b; }
    </style>
</head>
<body>
    <div class="header">
        <h1>🤖 Agent Hub</h1>
        <div class="status">
            <div class="status-dot"></div>
            <span>系统运行中</span>
        </div>
    </div>
    
    <div class="container">
        <div class="dashboard-title">教室视图 — 所有 Agent 状态</div>
        <div class="agents-grid" id="agentsGrid">
            <div class="loading">加载中...</div>
        </div>
    </div>
    
    <div class="footer">
        Agent Hub v0.1.0 · 本机多 Agent 统一管理中心
    </div>
    
    <script>
        const agents = [
            { id: 'claude', name: 'Claude Code', type: 'claude', icon: '🧠', desc: 'Anthropic Claude CLI，通过 CCR 网关提供 OpenAI 兼容 API', port: 3456, url: 'http://127.0.0.1:3456' },
            { id: 'pi', name: 'Pi Agent', type: 'pi', icon: '📝', desc: 'Pi Coding Agent，Web UI + 子 Agent 编排能力', port: 30141, url: 'http://192.168.5.102:30141' },
            { id: 'jcode', name: 'JCode', type: 'jcode', icon: '⚡', desc: 'OpenAI 兼容 API 网关，支持多模型路由', port: 3457, url: 'http://127.0.0.1:3457' },
            { id: 'tdai', name: 'TDAI Memory', type: 'tdai', icon: '🧬', desc: '腾讯 DB Agent 记忆核心，跨 Agent 分层记忆', port: 8420, url: 'http://127.0.0.1:8420' }
        ];
        
        function renderAgents() {
            const grid = document.getElementById('agentsGrid');
            grid.innerHTML = agents.map(a => `
                <div class="agent-card" onclick="window.open('${a.url}', '_blank')">
                    <div class="agent-card-header">
                        <div class="agent-icon ${a.type}">${a.icon}</div>
                        <div class="agent-status running">● 运行中</div>
                    </div>
                    <div class="agent-name">${a.name}</div>
                    <div class="agent-type">${a.type.toUpperCase()} · 端口 ${a.port}</div>
                    <div class="agent-desc">${a.desc}</div>
                    <div class="agent-meta">
                        <span>🔗 ${a.url}</span>
                        <span>📍 本机</span>
                    </div>
                </div>
            `).join('');
        }
        
        renderAgents();
    </script>
</body>
</html>
