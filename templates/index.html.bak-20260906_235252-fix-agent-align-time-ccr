<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agent Hub - 智管</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏫</text></svg>">
    <link rel="stylesheet" href="/static/vendor/xterm.css?v=20260906b">
    <style>
        /* ── US-003 明快高对比配色：单一色板源 :root，全文引用 var() ── */
        :root {
            --bg: #101a2e; --surface: #22334d; --surface-2: #2b3f5e;
            --border: #51637d; --divider: #3a4c68;
            --text-1: #f1f5f9; --text-2: #b8c6da; --muted: #9aa9bd;
            --accent: #3b82f6; --accent-2: #60a5fa; --info: #93c5fd;
            --btn: #2563eb; --btn-hover: #3b82f6;
            --amber: #f59e0b; --amber-soft: #fbbf24;
            --success: #22c55e; --success-text: #4ade80;
            --danger: #ef4444; --danger-text: #f87171; --warn: #eab308;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Noto Sans CJK SC', sans-serif; background: var(--bg); color: var(--text-1); min-height: 100vh; display: flex; flex-direction: column; }
        a { color: var(--accent-2); }
        button { cursor: pointer; font-family: inherit; }
        input, textarea, select { font-family: inherit; background: var(--bg); border: 1px solid var(--border); color: var(--text-1); border-radius: 8px; padding: 8px 10px; font-size: 13px; }
        input:focus, textarea:focus { outline: none; border-color: var(--accent-2); }
        .btn { background: var(--btn); border: none; color: #fff; border-radius: 8px; padding: 8px 14px; font-size: 13px; transition: .15s; }
        .btn:hover { background: var(--btn-hover); }
        .btn.ghost { background: transparent; border: 1px solid var(--border); color: var(--muted); }
        .btn.ghost:hover { border-color: var(--accent-2); color: var(--text-1); }
        .btn.danger { background: #dc2626; }
        .btn.danger:hover { background: var(--danger); }
        .btn.sm { padding: 4px 9px; font-size: 12px; }

        .header { background: linear-gradient(135deg, var(--surface) 0%, var(--bg) 100%); padding: 14px 32px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
        .header h1 { font-size: 20px; font-weight: 700; background: linear-gradient(90deg, #60a5fa, #a78bfa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .hstats { display: flex; align-items: center; gap: 14px; font-size: 12px; color: var(--text-2); flex-wrap: wrap; }
        .hdot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px; }
        .hdot.g { background: var(--success); animation: pulse 2s infinite; }
        .hdot.r { background: var(--danger); }

        nav.tabs { display: flex; gap: 4px; padding: 10px 32px 0; border-bottom: 1px solid var(--surface); background: var(--bg); flex-wrap: wrap; }
        nav.tabs button { background: transparent; border: none; color: var(--muted); padding: 10px 16px; font-size: 14px; border-bottom: 2px solid transparent; }
        nav.tabs button.on { color: var(--text-1); border-bottom-color: var(--accent-2); background: #22334d40; border-radius: 8px 8px 0 0; }

        main { flex: 1; max-width: 1400px; width: 100%; margin: 0 auto; padding: 24px 32px; }
        section.page { display: none; }
        section.page.on { display: block; }
        .hint { color: var(--muted); font-size: 12px; line-height: 1.5; }

        /* ── 教室 ── */
        .podium-wrap { display: flex; justify-content: center; margin: 8px 0 24px; }
        .podium { display: flex; flex-direction: column; align-items: center; gap: 8px; border: 2px solid #d97706; background: linear-gradient(180deg, #451a03cc, var(--surface)); border-radius: 18px; padding: 18px 44px; transition: .2s; }
        .podium:hover { transform: scale(1.04); box-shadow: 0 0 24px #d9770666; }
        .podium .crown { font-size: 30px; }
        .podium b { color: var(--amber-soft); font-size: 15px; }
        .podium span { font-size: 12px; color: var(--amber); }
        .divider { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
        .divider::before, .divider::after { content: ''; flex: 1; border-top: 1px dashed var(--border); }
        .divider span { font-size: 12px; letter-spacing: .2em; color: var(--muted); text-transform: uppercase; }

        /* ── 座位：US-002 紧凑横卡（面积约为原竖卡 30%，点击/hover 展开操作行） ── */
        .seats { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; max-width: 100%; margin: 0 auto; }
        .seat { position: relative; min-width: 0; border: 1px solid var(--border); background: var(--surface); border-radius: 12px; padding: 8px 10px; min-height: 56px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; transition: .15s; cursor: pointer; user-select: none; }
        .seat.s-running { border-color: #22c55e88; background: #22c55e14; }
        .seat.s-stopped { opacity: .85; }
        .seat.s-error { border-color: #ef4444aa; background: #ef444414; }
        .seat:hover, .seat.open { border-color: var(--accent-2); box-shadow: 0 2px 12px #0006; opacity: 1; }
        .s-badge { flex: 0 0 auto; width: 8px; height: 8px; border-radius: 50%; }
        .s-badge.running { background: var(--success); box-shadow: 0 0 6px var(--success); }
        .s-badge.stopped { background: var(--border); }
        .s-badge.error { background: var(--danger); box-shadow: 0 0 6px var(--danger); }
        .avatar { position: relative; flex: 0 0 auto; width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: 12px; }
        .avatar.running::after { content: ''; position: absolute; inset: -2px; border-radius: 11px; border: 2px solid #4ade8066; animation: ping 1.8s infinite; }
        .zsleep { position: absolute; bottom: -5px; right: -5px; font-size: 10px; }
        .s-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; line-height: 1.25; }
        .s-status { font-size: 12px; white-space: nowrap; flex: 0 0 auto; }
        .s-status.running { color: var(--success-text); }
        .s-status.stopped { color: var(--muted); }
        .s-status.error { color: var(--danger-text); }
        .s-name { font-size: 12px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .s-meta { display: flex; align-items: center; gap: 2px 6px; min-width: 0; flex-wrap: wrap; }
        .s-port { font-size: 12px; color: var(--muted); font-family: monospace; white-space: nowrap; flex: 0 0 auto; }
        .s-tools { display: none; flex-basis: 100%; flex-wrap: wrap; gap: 6px; padding-top: 6px; border-top: 1px dashed var(--border); }
        .seat:hover .s-tools, .seat.open .s-tools { display: flex; }
        .s-tools .btn { font-size: 12px; }
        @keyframes ping { 0% { transform: scale(1); opacity: .8; } 100% { transform: scale(1.5); opacity: 0; } }
        @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .4; } }

        /* ── 聊天 ── */
        .chat-grid { display: grid; grid-template-columns: 110px 1fr; gap: 16px; height: calc(100vh - 210px); min-height: 420px; }
        .chat-side { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 10px; overflow-y: auto; }
        .chat-side .item { padding: 10px; border-radius: 8px; font-size: 13px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
        .chat-side .item:hover, .chat-side .item.on { background: var(--surface-2); }
        .chips > summary { padding: 8px 10px; font-size: 13px; color: var(--info); cursor: pointer; list-style: none; user-select: none; border-radius: 8px; }
        .chips > summary::-webkit-details-marker { display: none; }
        .only-mob { display: none; }
        .chat-main { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
        .msgs { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
        .msg { max-width: 78%; padding: 10px 13px; border-radius: 12px; font-size: 14px; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }
        .msg.user { align-self: flex-end; background: var(--btn); border-bottom-right-radius: 4px; }
        .msg.assistant { align-self: flex-start; background: var(--surface-2); border-bottom-left-radius: 4px; }
        .msg.err { align-self: flex-start; background: #991b1b; }
        .steps { align-self: flex-start; width: 100%; display: flex; flex-direction: column; gap: 6px; }
        .step { font-size: 12px; border-radius: 8px; padding: 6px 10px; line-height: 1.5; }
        .step.thought { color: var(--text-2); font-style: italic; background: #101a2e80; }
        .step.toolcall { background: #78350f66; color: var(--amber-soft); font-family: monospace; }
        .step.toolresult { background: var(--bg); border: 1px solid var(--border); }
        .step.toolresult summary { color: var(--muted); cursor: pointer; }
        .step.toolresult pre { margin-top: 6px; max-height: 180px; overflow: auto; font-size: 12px; color: var(--text-2); white-space: pre-wrap; line-height: 1.5; }
        .composer { display: flex; gap: 8px; padding: 12px; border-top: 1px solid var(--border); }
        .composer input { flex: 1; }

        /* ── 表格/卡片通用 ── */
        .panel { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 16px; margin-bottom: 16px; }
        .panel h3 { font-size: 14px; margin-bottom: 10px; color: var(--info); }
        .tscroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; line-height: 1.45; }
        th, td { text-align: left; padding: 7px 9px; border-bottom: 1px solid var(--divider); }
        th { color: var(--muted); font-weight: 500; font-size: 12px; }
        tr:hover td { background: #ffffff0a; }
        .tag { display: inline-block; padding: 1px 8px; border-radius: 99px; font-size: 12px; background: var(--surface-2); color: var(--text-2); }
        .tag.fact { background: #1e3a5f; color: #bfdbfe; }
        .tag.decision { background: #4a3a08; color: #fde047; }
        .tag.constraint { background: #6b1226; color: #fda4af; }
        .tag.preference { background: #166534; color: #bbf7d0; }
        .tag.agent { background: var(--btn); color: #dbeafe; }

        .mem-grid { display: grid; grid-template-columns: 1.2fr .9fr .9fr; gap: 16px; }
        @media (max-width: 1100px) { .mem-grid { grid-template-columns: 1fr; } }
        .mem-list { max-height: 420px; overflow-y: auto; }
        .mem-item { border-bottom: 1px solid var(--divider); padding: 8px 2px; font-size: 13px; line-height: 1.5; display: flex; justify-content: space-between; gap: 8px; }
        .mem-item p { flex: 1; word-break: break-word; }
        textarea.doc { width: 100%; min-height: 130px; font-size: 13px; line-height: 1.55; }
        textarea[readonly] { color: var(--text-2); background: #101a2e80; }

        .toolbar { display: flex; gap: 8px; align-items: center; margin-bottom: 14px; flex-wrap: wrap; }
        .toolbar input { flex: 1; min-width: 180px; }
        pre.code { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 12px; font-size: 12.5px; overflow-x: auto; color: #a5f3fc; line-height: 1.5; }

        .modal-mask { position: fixed; inset: 0; background: #000b; display: none; align-items: center; justify-content: center; z-index: 50; }
        .modal-mask.on { display: flex; }
        .modal { width: min(560px, 92vw); background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 20px; max-height: 86vh; overflow-y: auto; }
        .modal h3 { margin-bottom: 12px; font-size: 15px; }
        .modal .row { display: flex; gap: 8px; margin-bottom: 10px; }
        .modal .row input { flex: 1; }

        #toast { position: fixed; bottom: 26px; left: 50%; transform: translateX(-50%); z-index: 99; display: flex; flex-direction: column; gap: 8px; align-items: center; }
        #toast div { background: var(--bg); border: 1px solid var(--border); padding: 10px 18px; border-radius: 10px; font-size: 13px; animation: pulse 3s forwards; box-shadow: 0 8px 24px #000a; }
        #toast div.err { border-color: var(--danger); color: #fca5a5; }
        #toast div.ok { border-color: var(--success); color: #86efac; }

        .footer { text-align: center; padding: 16px; color: var(--muted); font-size: 12px; border-top: 1px solid var(--surface); }

        /* ── 基础设施区（服务/网关/工具：仅快捷方式）── */
        .infra-box { max-width: 980px; margin: 26px auto 0; border: 1px solid var(--border); border-radius: 14px; background: var(--surface); padding: 10px 14px; }
        .infra-box summary { cursor: pointer; font-size: 13px; color: var(--text-2); padding: 6px 2px; user-select: none; }
        .infra-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; margin-top: 10px; }
        .chip { display: flex; align-items: center; gap: 8px; border: 1px solid var(--border); background: var(--bg); border-radius: 10px; padding: 8px 10px; min-width: 0; }
        .chip .dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
        .chip .dot.on { background: var(--success); box-shadow: 0 0 6px var(--success); }
        .chip .dot.off { background: var(--muted); }
        .chip b { font-size: 12px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
        .chip .kindtag { font-size: 10px; color: var(--text-2); background: var(--surface); border-radius: 6px; padding: 1px 6px; flex: none; }
        .chip .btn { flex: none; }
        .s-kind { font-size: 10px; padding: 1px 7px; border-radius: 99px; background: var(--bg); color: var(--text-2); margin-left: 4px; }
        .seat.s-installed { border-color: #eab308aa; background: #eab3080d; }
        .s-badge.installed { background: #eab308; box-shadow: 0 0 8px #eab308; }
        .s-status.installed { color: #eab308; }
        .avatar.installed { opacity: .85; }

        /* ── 会话嵌入 / 终端 ── */
        .pane { flex: 1; display: none; flex-direction: column; min-height: 0; }
        .pane.on { display: flex; }
        .pane .bar { display: flex; gap: 8px; align-items: center; padding: 8px 10px; border-bottom: 1px solid var(--border); flex: none; flex-wrap: wrap; }
        .pane iframe { flex: 1; width: 100%; border: 0; background: #fff; min-height: 0; }
        #termEl { flex: 1; min-height: 0; padding: 6px; background: #0b1220; overflow: hidden; }
        .sess-item { font-size: 11px; background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 3px 8px; display: inline-flex; gap: 6px; align-items: center; }

        /* ── 移动端自适应（US-001：消除左偏留白/页签换行/两栏错位） ── */
        @media (max-width: 767px) {
            .header { padding: 10px 12px; gap: 8px; }
            .header h1 { font-size: 17px; }
            .hstats { gap: 10px; }
            nav.tabs { padding: 8px 12px 0; gap: 2px; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
            nav.tabs::-webkit-scrollbar { display: none; }
            nav.tabs button { flex: 0 0 auto; min-height: 40px; white-space: nowrap; padding: 10px 12px; font-size: 13px; }
            main { max-width: 100%; margin: 0; padding: 12px; }
            .podium-wrap { margin: 4px 0 16px; }
            .podium { flex-direction: row; flex-wrap: wrap; max-width: 100%; gap: 8px 10px; padding: 10px 14px; border-radius: 14px; }
            .podium .crown { font-size: 22px; }
            .podium b { font-size: 13px; }
            .podium span { font-size: 12px; }
            .seats { gap: 8px; }
            .seat { padding: 7px 8px; gap: 6px; }
            .avatar { width: 28px; height: 28px; font-size: 12px; }
            select { max-width: 100%; }
            .toolbar input, .toolbar select { min-width: 0; }
            .mem-grid { gap: 10px; }
            .mem-grid > * { min-width: 0; }
            .only-mob { display: block; }
            .chips > summary::after { content: ' ▾'; font-size: 12px; }
            .chips:not([open]) > summary::after { content: ' ▸'; }
            .chat-grid { grid-template-columns: 1fr; height: auto; min-height: 0; gap: 10px; }
            #chatAgents { display: flex; flex-direction: row; align-items: center; gap: 8px; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding: 2px 0 4px; }
            #chatAgents::-webkit-scrollbar { display: none; }
            #chatAgents .item { flex: 0 0 auto; white-space: nowrap; background: var(--bg); border: 1px solid var(--border); border-radius: 99px; padding: 8px 12px; }
            #chatAgents .item.on { background: var(--btn); border-color: var(--accent-2); }
            .chat-main { height: 62vh; min-height: 360px; }
            .mem-grid { grid-template-columns: 1fr !important; }
            .panel { padding: 12px; }
            .toolbar input { min-width: 140px; }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>🏫 Agent Hub · 智管</h1>
        <div class="hstats">
            <span><span class="hdot g"></span>Hub 在岗</span>
            <span id="hAgents">Agents: -</span>
            <span id="hErrors"></span>
            <span id="hTime" class="hint"></span>
        </div>
    </div>

    <nav class="tabs" id="tabs">
        <button data-page="classroom" class="on">🏫 教室</button>
        <button data-page="manager">👑 指挥官</button>
        <button data-page="chat">💬 统一对话</button>
        <button data-page="memory">🧠 记忆中心</button>
        <button data-page="tasks">⚡ 协同</button>
        <button data-page="jobs">⏰ 定时</button>
        <button data-page="mcp">🧰 工具</button>
        <button data-page="ports">🔌 端口</button>
        <button data-page="telemetry">📡 遥测</button>
    </nav>

    <main>
        <!-- 教室 -->
        <section class="page on" id="page-classroom">
            <div class="podium-wrap">
                <div class="podium" onclick="go('manager')">
                    <div class="crown">👑</div>
                    <b>Manager 指挥官</b>
                    <span>用自然语言指挥所有 Agent →</span>
                </div>
            </div>
            <div class="divider"><span>学生座位 · 仅 Agent</span></div>
            <div class="seats" id="seats"><div class="hint" style="grid-column:1/-1;text-align:center;padding:30px">加载中…</div></div>
            <details class="infra-box" id="infraBox">
                <summary>⚙️ 基础设施（网关 / 服务 / 记忆 / 工具 —— 非 Agent，仅快捷方式）<span class="hint" id="infraCount"></span></summary>
                <div class="infra-grid" id="infraGrid"></div>
            </details>
            <div style="text-align:center;margin-top:22px">
                <button class="btn ghost" onclick="openRegister()">＋ 注册自定义 Agent</button>
                <button class="btn ghost" onclick="runScan()">🔍 自动扫描（docker/systemd 只读发现）</button>
            </div>
        </section>

        <!-- 指挥官 -->
        <section class="page" id="page-manager">
            <div class="chat-grid">
                <details class="chat-side chips" open>
                    <summary class="chips-sum">使用提示</summary>
                    <div class="hint" style="padding:0 10px;line-height:1.7">
                        例：<br>「现在哪些 Agent 在运行？」<br>「打开 pi 的界面」<br>「查一下记忆里关于 CCR 的约束」<br>「3457 端口是谁在用？」<br>「记住：我偏好中文回复」<br><br>工具在服务端真执行；会话已持久化。
                    </div>
                    <div style="padding:10px"><button class="btn ghost sm" onclick="clearMgr()">＋ 新会话</button></div>
                </details>
                <div class="chat-main">
                    <div class="msgs" id="mgrMsgs"><div class="hint" style="margin:auto">向指挥官下达指令</div></div>
                    <div class="composer">
                        <input id="mgrInput" placeholder="例如：列出所有 Agent 状态" onkeydown="if(event.key==='Enter')mgrSend()">
                        <button class="btn" onclick="mgrSend()">发送</button>
                    </div>
                </div>
            </div>
        </section>

        <!-- 统一对话（Agent 原生会话嵌入 / 终端 / 智管对话） -->
        <section class="page" id="page-chat">
            <div class="chat-grid">
                <details class="chat-side chips" open>
                    <summary class="chips-sum only-mob">Agent 列表</summary>
                    <div id="chatAgents"></div>
                </details>
                <div class="chat-main">
                    <div class="bar" id="chatModeBar" style="display:none;gap:6px;padding:8px 10px;border-bottom:1px solid var(--border)"></div>
                    <!-- 模式1：原生 Web UI 嵌入 -->
                    <div class="pane" id="embedPane">
                        <div class="bar"><b id="embedTitle" style="font-size:13px"></b>
                            <button class="btn ghost sm" onclick="embedRefresh()">刷新</button>
                            <button class="btn ghost sm" onclick="embedNewTab()">新窗口打开</button>
                            <span class="hint" id="embedUrlHint"></span></div>
                        <iframe id="embedFrame" src="about:blank"></iframe>
                    </div>
                    <!-- 模式2：pty 终端 -->
                    <div class="pane" id="termPane">
                        <div class="bar"><b id="termTitle" style="font-size:13px"></b>
                            <button class="btn sm" onclick="termNew()">＋ 新会话</button>
                            <button class="btn ghost sm" onclick="termRefreshList()">会话</button>
                            <button class="btn ghost sm" onclick="termKill()">销毁当前</button>
                            <span id="termSessList" style="display:flex;gap:6px;flex-wrap:wrap"></span></div>
                        <div id="termEl"></div>
                    </div>
                    <!-- 模式3：对话框（智管自身/有 chat 适配器者） -->
                    <div class="pane on" id="chatPane">
                        <div class="msgs" id="chatMsgs"><div class="hint" style="margin:auto">左侧选择一个 Agent 或「智管对话」</div></div>
                        <div class="composer">
                            <select id="chatModel" style="max-width:180px;font-size:12px;">
                                <option value="">默认模型</option>
                                <option value="tokenrouter/qwen3.8-flash">Qwen 3.8 Flash (默认)</option>
                                <option value="open_router/nvidia/nemotron-3-ultra-550b-a55b:free">Nemotron 3 Ultra</option>
                                <option value="open_router/minimax/minimax-m3:free">MiniMax M3</option>
                                <option value="agnes/agnes-2.5-flash">Agnes 2.5 Flash</option>
                            </select>
                            <input id="chatInput" placeholder="消息…" onkeydown="if(event.key==='Enter')chatSend()">
                            <button class="btn" onclick="chatSend()">发送</button>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 记忆中心 -->
        <section class="page" id="page-memory">
            <div class="mem-grid">
                <div class="panel">
                    <h3>L1 · 可检索记忆</h3>
                    <div class="toolbar">
                        <input id="memQ" placeholder="搜索…" onkeydown="if(event.key==='Enter')loadMemories()">
                        <select id="memCat" onchange="loadMemories()">
                            <option value="">全部分类</option><option>fact</option><option>decision</option><option>constraint</option><option>preference</option>
                        </select>
                    </div>
                    <div class="mem-list" id="memList"></div>
                    <div class="row toolbar" style="margin-top:10px">
                        <input id="memNew" placeholder="新增一条记忆…">
                        <button class="btn sm" onclick="addMemory()">添加</button>
                    </div>
                    <div class="hint">L2 由 L1 经 LLM 压缩生成；manual 手写区自动流程永不触碰（与上游语义一致）</div>
                </div>
                <div class="panel">
                    <h3>L2 · 近 30 天工作记忆</h3>
                    <textarea class="doc" id="l2content" readonly placeholder="（尚无生成内容）"></textarea>
                    <div class="hint" style="margin:6px 0">手写补充 manual：</div>
                    <textarea class="doc" id="l2manual" style="min-height:80px"></textarea>
                    <div class="toolbar" style="margin-top:8px">
                        <button class="btn sm" onclick="saveDoc('l2')">保存</button>
                        <button class="btn ghost sm" onclick="rebuildL2()">🔄 用 LLM 重建</button>
                    </div>
                </div>
                <div class="panel">
                    <h3>L3 · 长期 Profile</h3>
                    <textarea class="doc" id="l3content" placeholder="人工确认后写入的稳定长期偏好（草稿→确认制）"></textarea>
                    <div class="hint" style="margin:6px 0">手写补充 manual：</div>
                    <textarea class="doc" id="l3manual" style="min-height:80px"></textarea>
                    <div class="toolbar" style="margin-top:8px">
                        <button class="btn sm" onclick="saveDoc('l3')">保存</button>
                        <button class="btn ghost sm" onclick="previewCtx()">注入预览</button>
                    </div>
                </div>
            </div>
            <div class="panel" id="ctxPanel" style="display:none"><h3>注入上下文包（/api/memory/context）</h3><pre class="code" id="ctxBody"></pre></div>
        </section>

        <!-- 协同 DAG -->
        <section class="page" id="page-tasks">
            <div class="panel">
                <h3>Leader 拆解 · DAG 协同执行（SQLite 状态机，重启可恢复）</h3>
                <div class="row toolbar"><textarea id="taskGoal" class="doc" style="min-height:60px" placeholder="复杂任务目标，例如：分别介绍 A 与 B（并行），再汇总对比"></textarea></div>
                <div class="toolbar">
                    <select id="taskAgent"><option value="">自动选择执行 Agent</option></select>
                    <button class="btn" id="btnDecompose" onclick="decomposeRun()">🧩 拆解并启动</button>
                    <button class="btn ghost" onclick="loadRuns()">刷新列表</button>
                </div>
            </div>
            <div class="panel" style="padding:0;overflow-x:auto">
                <table><thead><tr><th>Run</th><th>目标</th><th>状态</th><th>进度</th><th>创建</th><th></th></tr></thead>
                <tbody id="runsBody"></tbody></table>
            </div>
            <div class="panel tscroll" id="runPanel" style="display:none">
                <h3 id="runTitle"></h3>
                <div id="dagSvg" style="overflow-x:auto"></div>
                <table><thead><tr><th>任务</th><th>Agent</th><th>依赖</th><th>状态</th><th>耗时</th><th>输出/错误（点击行展开）</th></tr></thead>
                <tbody id="taskBody"></tbody></table>
                <div class="toolbar" style="margin-top:10px">
                    <button class="btn ghost sm" onclick="startRun(currentRun)">▶ 启动/续跑</button>
                    <button class="btn ghost sm" onclick="retryRun(currentRun)">↻ 重试失败项</button>
                    <button class="btn danger sm" onclick="delRun(currentRun)">删除</button>
                </div>
            </div>
        </section>

        <!-- 定时任务 -->
        <section class="page" id="page-jobs">
            <div class="panel">
                <h3>新建定时任务（本地时区 5 段 cron；shell 类走白名单）</h3>
                <div class="toolbar">
                    <input id="jobName" placeholder="任务名" style="max-width:160px">
                    <input id="jobCron" placeholder="*/5 9-18 * * 1-5" style="max-width:160px">
                    <select id="jobKind" onchange="jobKindChange()"><option value="shell">shell</option><option value="agent_prompt">agent_prompt</option><option value="http">http</option></select>
                    <select id="jobAgent" style="max-width:140px"></select>
                </div>
                <div class="toolbar"><input id="jobPayload" placeholder="命令 / Prompt 文本 / URL" style="flex:1"></div>
                <div class="toolbar"><span class="hint" id="jobAllow"></span><button class="btn" onclick="createJob()">创建</button></div>
            </div>
            <div class="panel" style="padding:0;overflow-x:auto">
                <table><thead><tr><th>名称</th><th>cron</th><th>类型</th><th>启用</th><th>最近执行</th><th>状态</th><th>结果</th><th></th></tr></thead>
                <tbody id="jobsBody"></tbody></table>
            </div>
        </section>

        <!-- MCP 工具网关 -->
        <section class="page" id="page-mcp">
            <div class="panel">
                <h3>注册 MCP Server（stdio 命令 / http URL；聚合后供全部 Agent 与指挥官调用）</h3>
                <div class="toolbar">
                    <input id="mcName" placeholder="名称" style="max-width:140px">
                    <select id="mcTransport"><option value="stdio">stdio</option><option value="http">http</option></select>
                    <input id="mcCmd" placeholder="command，如 /home/gztxt/agent-hub/venv/bin/python3">
                    <input id="mcArgs" placeholder="args（空格分隔）或 http URL" style="flex:1">
                </div>
                <div class="toolbar">
                    <button class="btn ghost sm" onclick="probeServer()">🔎 探测工具（不落库）</button>
                    <button class="btn sm" onclick="addServer()">注册</button>
                    <button class="btn ghost sm" onclick="loadMcp()">刷新聚合</button>
                </div>
                <pre class="code" id="mcProbe" style="display:none"></pre>
            </div>
            <div class="mem-grid" style="grid-template-columns:1fr 1.3fr">
                <div class="panel"><h3>Servers</h3><div id="mcServers" class="hint tscroll">加载中…</div></div>
                <div class="panel"><h3>聚合工具（60s 缓存）</h3><div id="mcTools" class="hint">加载中…</div>
                    <div class="toolbar" style="margin-top:10px"><input id="mcCallArgs" placeholder='{"text":"hi"}' style="flex:1"><button class="btn sm" onclick="callToolSel()">测试调用选中工具</button></div>
                    <pre class="code" id="mcCallOut" style="display:none"></pre>
                </div>
            </div>
        </section>

        <!-- 端口 -->
        <section class="page" id="page-ports">
            <div class="toolbar">
                <input id="portFilter" placeholder="过滤端口/进程/地址…" oninput="renderPorts()">
                <span class="hint">🔒 只读——本机进程由 systemd/守护方管理，不提供 kill（与上游桌面版的有意差异）</span>
            </div>
            <div class="panel" style="padding:0;overflow-x:auto">
                <table><thead><tr><th>协议</th><th>端口</th><th>地址</th><th>PID</th><th>进程</th><th>Agent</th></tr></thead>
                <tbody id="portsBody"></tbody></table>
            </div>
        </section>

        <!-- 遥测 -->
        <section class="page" id="page-telemetry">
            <div class="panel">
                <h3>接入方式（覆盖式账本：同 source+session 重报取末值，不叠加）</h3>
                <pre class="code" id="curlExample"></pre>
                <div class="hint">未设置 HOOK_AUTH_TOKEN 时仅接受回环来源写入；对外接入请在 .env 配置 token</div>
            </div>
            <div class="mem-grid" style="grid-template-columns:1fr 1fr">
                <div class="panel"><h3>Token 用量聚合</h3><div id="usageTable" class="hint tscroll">加载中…</div></div>
                <div class="panel"><h3>最近事件</h3><div id="eventTable" class="hint tscroll">加载中…</div></div>
            </div>
            <div class="panel"><h3>Agent 画像（成功率 / 平均耗时 — S2 profile_events）</h3><div id="profTable" class="hint tscroll">加载中…</div></div>
        </section>
    </main>

    <!-- 注册弹窗 -->
    <div class="modal-mask" id="regMask">
        <div class="modal">
            <h3>注册自定义 Agent（自动识别项目类型）</h3>
            <div class="row"><input id="regDir" placeholder="项目目录绝对路径，如 /home/gztxt/my-agent"><button class="btn ghost sm" onclick="detectDir()">识别</button></div>
            <pre class="code" id="regDetect" style="display:none"></pre>
            <div class="row"><input id="regName" placeholder="名称（可空，默认取目录名）"></div>
            <div class="toolbar" style="justify-content:flex-end">
                <button class="btn ghost" onclick="closeRegister()">取消</button>
                <button class="btn" onclick="registerAgent()">注册</button>
            </div>
        </div>
    </div>

    <div class="footer">Agent Hub v0.2.0 · 融合 Agent_Manager (Apache-2.0) 设计理念 · <span id="ftTime"></span></div>
    <div id="toast"></div>
    <script src="/static/vendor/xterm.js?v=20260906b"></script>
    <script src="/static/vendor/fit.js?v=20260906b"></script>
    <script src="/static/hub.js?v=20260906b"></script>
</body>
</html>
