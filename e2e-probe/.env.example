# e2e-probe 运行前提（复制成 .env 后按需改；本仓 .env 已被 gitignore）
#
# 用法：export CCR_API_KEY=... 后再 npx e2e run
#       零模型用例不需要本文件里的任何一项。

# 本机 CCR 网关（唯一在役网关）。复用既有 ccr-profile 凭据，零新增。
CCR_BASE_URL=http://127.0.0.1:3456/v1

# 🚫 绝不填 openrouter/auto —— 它的语义是「自动挑最便宜的可用模型」，
#    最便宜的可能是付费模型 ⇒ 直接产生账户扣款（AGENTS.md §1 硬规则 4）。
#    经 CCR 时 ID 写作 openrouter/openrouter/free（路由器写法，不受免费池轮换影响）。
E2E_MODEL=openrouter/openrouter/free

# 取值来源（不要把真值写进本文件）：
#   grep -hoE '^JCODE_PROVIDER_CCR_API_KEY=.*' ~/.config/jcode/provider-ccr.env \
#     | cut -d= -f2- | tr -d '"'"'"' '
CCR_API_KEY=

# 被测应用。默认生产实例 :3102，只读打测。
APP_URL=http://127.0.0.1:3102

# ⚠️ 必设。不设会去 ~/.cache/ms-playwright（本机为空）找浏览器然后去 CDN 下载，
#    而本机外网直连不通 ⇒ 卡住。设了则复用 /vol1 下已有的 chromium_headless_shell-1243，
#    与 @e2e-dev/web 依赖的 playwright-core@1.63.0 要求的 revision 恰好一致。
PLAYWRIGHT_BROWSERS_PATH=/vol1/venv/c4ai-browsers

# 禁遥测：不向外发送任何数据（本仓军规：不擅自把本机信息发出去）。
E2E_TELEMETRY_DISABLED=1